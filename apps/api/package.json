{
  "name": "@dean/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node --env-file=../../.env dist/server.js",
    "db:generate": "node --env-file=../../.env ../../node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=../../.env ../../node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "tsx --env-file=../../.env src/scripts/seed.ts",
    "test": "node --env-file=../../.env --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "argon2": "^0.45.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.0",
    "jose": "^6.2.16",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
