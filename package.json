{
  "name": "digital-dean",
  "private": true,
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/api",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:stop": "docker compose stop db",
    "build": "npm run build -w apps/api",
    "start": "npm run start -w apps/api",
    "check": "npm run check -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:reset-demo-passwords": "npm run db:reset-demo-passwords -w apps/api",
    "db:reset-demo-teacher-password": "npm run db:reset-demo-teacher-password -w apps/api",
    "db:reset-demo-staff-password": "npm run db:reset-demo-staff-password -w apps/api",
    "test": "npm run test -w apps/api",
    "test:unit": "npm run test:unit -w apps/api",
    "test:integration": "npm run test:integration -w apps/api"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3"
  },
  "devDependencies": {
    "neon": "^9.4.0"
  }
}
